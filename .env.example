# Copie para .env.local e altere em produção (Vercel → Settings → Environment Variables)

# --- Autenticação admin ---
AUTH_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@brunozarath.app
# Gere com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))"
ADMIN_PASSWORD_HASH=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://brunozarath.app

# --- Pagamentos Mercado Pago (Brasil: PIX, crédito, débito) ---
# Sandbox: https://www.mercadopago.com.br/developers/panel/app
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-...
# MERCADOPAGO_WEBHOOK_SECRET=opcional-assinatura-webhook

# --- Upload persistente na Vercel ---
# BLOB_READ_WRITE_TOKEN=
